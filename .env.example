# Modelo (mantener los valores reales fuera de Git)
#
# OpenAI en la nube: deja OPENAI_BASE_URL vacío e indica tu clave.
# Ollama local: OPENAI_BASE_URL=http://127.0.0.1:11434/v1,
# OPENAI_API_KEY=ollama y OPENAI_MODEL=qwen2.5:7b.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Modelo pequeño para interpretar saludos y solicitudes de ayuda en lenguaje libre.
OPENAI_INTENT_MODEL=gpt-4o-mini
USE_LLM_INTENT_CLASSIFIER=true
# Guardia semántica opcional antes de intención y recuperación. Mantener en
# observe durante el piloto; enforce bloquea antes de Azure AI Search.
USE_CONTEXT_GUARD=false
CONTEXT_GUARD_MODEL=gpt-4o-mini
CONTEXT_GUARD_MODE=observe
CONTEXT_GUARD_TIMEOUT_SECONDS=2
CONTEXT_GUARD_FAILURE_POLICY=block
PORT=3978
# En producción, readiness exige Azure AI Search además del modelo. Para la
# ejecución local, el fallback documental puede permanecer disponible.
LIBRAS_ENV=local
REQUIRE_AZURE_SEARCH=false
# En desarrollo, el respaldo Markdown se usa por defecto aunque Azure esté
# configurado. Activa esta opción solo para probar Azure AI Search localmente.
USE_AZURE_SEARCH_IN_LOCAL=false
# Estrategia de recuperación: legacy mantiene el comportamiento actual. v2 se
# activa únicamente después de reconstruir libras-docs y aprobar las puertas
# del corpus de calidad; cambiar a legacy permite reversión inmediata.
RETRIEVAL_STRATEGY=legacy
# Identificador no sensible de la versión desplegada, expuesto solamente por
# /readyz para confirmar una reversión o promoción.
LIBRAS_RUNTIME_REVISION=unversioned
# Permite al proceso de ingestión actualizar los campos de calidad V2 sin
# activar la recuperación V2 en el chat. Mantener apagado en la aplicación.
INDEX_QUALITY_METADATA_ENABLED=false
# Verificación semántica limitada a candidatos ya recuperados. Se activa con
# v2 solo después de validar su latencia y el corpus; si no está disponible,
# Libras conserva el verificador determinista y falla cerrado.
USE_LLM_EVIDENCE_VERIFIER=false
EVIDENCE_VERIFIER_MODEL=gpt-4o-mini

# Azure AI Search: endpoint del recurso existente y una clave de consulta o administración.
AZURE_SEARCH_ENDPOINT=https://<tu-servicio>.search.windows.net
AZURE_SEARCH_INDEX_NAME=libras-docs
AZURE_SEARCH_API_KEY=
# Alternativa a la clave: autenticación de Microsoft Entra con roles de datos.
AZURE_SEARCH_USE_ENTRA_ID=false
# Actívalo sólo si el servicio tiene semantic ranker habilitado.
AZURE_SEARCH_USE_SEMANTIC=false
AZURE_SEARCH_SEMANTIC_CONFIGURATION=default
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Tiempo máximo por etapa del mensaje de Teams. Ante timeout, Libras aplica
# la política local y evita bloquear el worker del bot.
RETRIEVAL_TIMEOUT_SECONDS=12
# Ventana adicional para aceptar evidencia que termina después del primer
# límite, por ejemplo durante el calentamiento de Azure AI Search.
RETRIEVAL_GRACE_SECONDS=8
CLASSIFICATION_TIMEOUT_SECONDS=12
INTENT_TIMEOUT_SECONDS=3
CONVERSATION_TIMEOUT_SECONDS=4

# Microsoft Graph / SharePoint. La configuración actual permite una prueba local
# delegada. La producción debe usar la identidad corporativa aprobada para Libras.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_AUTH_MODE=delegated
# Sólo para SHAREPOINT_AUTH_MODE=application. En producción debe llegar desde
# una referencia de Key Vault, nunca desde Git ni logs.
SHAREPOINT_CLIENT_SECRET=
# Opcional para trazabilidad; la sincronización usa directamente el drive.
SHAREPOINT_SITE_ID=
# Obligatorio en modo application; en delegated puede quedar vacío para el
# OneDrive del usuario local.
SHAREPOINT_DRIVE_ID=
# Obligatoria en modo application; ejemplo: Documentos compartidos/Manuales
SHAREPOINT_FOLDER_PATH=
# Etiquetas legibles para responder preguntas sobre el alcance. No incluir IDs,
# secretos ni rutas internas. Separar varias fuentes con coma o punto y coma.
# Ejemplo: ReadME Hotfixes,Documentos/SOLUCIONES,Manuales
LIBRAS_SHAREPOINT_SOURCE_LABELS=
